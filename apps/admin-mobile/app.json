{
  "expo": {
    "owner": "obai35",
    "name": "Gümüş Güneş Admin",
    "slug": "gumusgunes-admin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "gumusgunes-admin",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "cli": {
      "appVersionSource": "remote"
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gumusgunes.admin"
    },
    "android": {
      "package": "com.gumusgunes.admin",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "permissions": [
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "kotlinVersion": "1.9.25"
          }
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://gumusgunes.vercel.app",
      "socketUrl": "https://gumusgunes-socket.up.railway.app",
      "eas": {
        "projectId": "66601809-ac07-42bd-8685-5e54a1dc3000"
      }
    }
  }
}
