{
	"appId": "com.gumusgunes.app",
	"appName": "Gümüş Güneş",
	"webDir": "www",
	"server": {
		"cleartext": true
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 2000,
			"launchAutoHide": true,
			"backgroundColor": "#0a1628",
			"androidScaleType": "CENTER_CROP",
			"splashFullScreen": true,
			"splashImmersive": true
		},
		"StatusBar": {
			"style": "DARK",
			"backgroundColor": "#0a1628"
		}
	},
	"android": {
		"allowMixedContent": true
	},
	"packageClassList": []
}
