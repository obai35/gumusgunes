// Gümüş Güneş — Silver Sun Jewelry E-Commerce Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Multi-Tenant Store ──

model Store {
  id                   String    @id @default(cuid())
  name                 String
  slug                 String    @unique
  email                String
  phone                String?
  address              String?
  logo                 String?
  favicon              String?
  primaryDomain        String?   @unique
  customDomains        String    @default("[]")
  plan                 String    @default("free") // free, starter, business, enterprise, lifetime
  trialEndsAt          DateTime?
  subscriptionStatus   String    @default("active") // active, trialing, past_due, canceled, paused
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  isActive             Boolean   @default(true)
  isSetupComplete      Boolean   @default(false)
  themeSettings        String    @default("{}") // JSON: colors, fonts, CSS vars, layout
  metadata             String    @default("{}") // JSON: extra config
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  products             Product[]
  categories           Category[]
  brands               Brand[]
  orders               Order[]
  users                User[]
  admins               Admin[]
  roles                Role[]
  siteSettings         SiteSetting[]
  discounts            Discount[]
  newsletters          Newsletter[]
  branches             Branch[]
  paymentMethods       PaymentMethod[]
  shippingMethods      ShippingMethod[]
  governorates         Governorate[]
  suppliers            Supplier[]
  expenses             Expense[]
  shifts               Shift[]
  blogPosts            BlogPost[]
  faqEntries           FaqEntry[]
  banners              Banner[]
  staticPages          StaticPage[]
  activityLogs         ActivityLog[]
  webhooks             Webhook[]
  apiKeys              ApiKey[]
  featureFlags         FeatureFlag[]
  socialAccounts       SocialAccount[]
  socialPosts          SocialPost[]
  socialDrafts         SocialDraft[]
  socialCampaigns      SocialCampaign[]
  loyaltyTiers         LoyaltyTier[]
  customerSegments     CustomerSegment[]
  abandonedCarts       AbandonedCart[]
  emailCampaigns       EmailCampaign[]
  pushCampaigns        PushCampaign[]
  saleCampaigns        SaleCampaign[]
  giftCards            GiftCard[]
  referrals            Referral[]
  referrerConfigs      ReferralConfig[]
  accounts             Account[]
  budgets              Budget[]
  bankAccounts         BankAccount[]
  invoices             Invoice[]
  bills                Bill[]
  journalEntries       JournalEntry[]
  currencies           Currency[]
  translations         Translation[]
  taxRates             TaxRate[]
  warehouses           Warehouse[]
  employees            Employee[]
  payrollRuns          PayrollRun[]
  conversations        Conversation[]
  scheduledReports     ScheduledReport[]
  qcTemplates          QC_Template[]
  returnRequests       ReturnRequest[]
  purchaseOrders       PurchaseOrder[]
  addresses            Address[]
  backInStock          BackInStock[]
  bankTransactions     BankTransaction[]
  billItems            BillItem[]
  branchStocks         BranchStock[]
  customerActivityLogs CustomerActivityLog[]
  customerNotes        CustomerNote[]
  customerPushTokens   CustomerPushToken[]
  emailLogs            EmailLog[]
  inventoryLogs        InventoryLog[]
  invoiceItems         InvoiceItem[]
  journalLines         JournalLine[]
  messages             Message[]
  orderItems           OrderItem[]
  otpVerifications     OtpVerification[]
  payrollItems         PayrollItem[]
  productEmbeddings    ProductEmbedding[]
  productRelations     ProductRelation[]
  pushPreferences      PushPreference[]
  pushTokens           PushToken[]
  qcChecks             QC_Check[]
  purchaseOrderItems   PurchaseOrderItem[]
  resetTokens          ResetToken[]
  returnItems          ReturnItem[]
  returns              Return[]
  reviews              Review[]
  savedCards           SavedCard[]
  shipments            Shipment[]
  shippingRates        ShippingRate[]
  shippingRules        ShippingRule[]
  stockLevels          StockLevel[]
  stockTransfers       StockTransfer[]
  webhookDeliveries    WebhookDelivery[]
  wishlistItems        WishlistItem[]
}

model Product {
  id                 String              @id @default(cuid())
  storeId            String
  store              Store               @relation(fields: [storeId], references: [id])
  name               String
  slug               String              @unique
  description        String
  price              Float
  compareAtPrice     Float?
  sku                String              @unique
  categoryId         String
  category           Category            @relation(fields: [categoryId], references: [id])
  brandId            String?
  brand              Brand?              @relation(fields: [brandId], references: [id])
  imageUrl           String
  images             String // JSON array of image URLs
  material           String
  weight             String?
  rating             Float               @default(0)
  reviewCount        Int                 @default(0)
  stock              Int                 @default(0)
  costPrice          Float?
  tags               String // JSON array of tags
  isActive           Boolean             @default(true)
  isFeatured         Boolean             @default(false)
  isNew              Boolean             @default(false)
  isBestseller       Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  reviews            Review[]
  orderItems         OrderItem[]
  wishlistItems      WishlistItem[]
  backInStock        BackInStock[]
  inventoryLogs      InventoryLog[]
  returnItems        ReturnItem[]
  stocks             BranchStock[]
  transfers          StockTransfer[]
  fromRelations      ProductRelation[]   @relation("FromProduct")
  toRelations        ProductRelation[]   @relation("ToProduct")
  embedding          ProductEmbedding?
  stockLevels        StockLevel[]
  purchaseOrderItems PurchaseOrderItem[]
  returnRequests     ReturnRequest[]
  qcChecks           QC_Check[]
  invoiceItems       InvoiceItem[]

  @@index([categoryId, isActive])
  @@index([brandId])
  @@index([isActive, isFeatured])
  @@index([isActive, isNew])
  @@index([isActive, isBestseller])
  @@index([price])
  @@index([createdAt])
}

model Brand {
  id        String    @id @default(cuid())
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id])
  name      String
  nameAr    String?
  slug      String    @unique
  logo      String?
  isVisible Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([storeId])
}

// ── Accounting / Double-Entry ──

enum RelationType {
  MATCHES
  COMPLEMENTS
  SIMILAR_TO
  ALSO_BOUGHT
  OCCASION
  COLLECTION
}

model ProductRelation {
  id        String       @id @default(cuid())
  storeId   String
  store     Store        @relation(fields: [storeId], references: [id])
  fromId    String
  from      Product      @relation("FromProduct", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        Product      @relation("ToProduct", fields: [toId], references: [id], onDelete: Cascade)
  type      RelationType
  weight    Float        @default(1.0)
  metadata  Json?
  createdAt DateTime     @default(now())

  @@unique([fromId, toId, type])
  @@index([fromId, type, weight])
  @@index([toId, type])
  @@index([storeId])
}

model ProductEmbedding {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  productId String   @unique
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  vector    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
}

model Category {
  id          String     @id @default(cuid())
  storeId     String
  store       Store      @relation(fields: [storeId], references: [id])
  name        String
  slug        String     @unique
  description String?
  imageUrl    String?
  icon        String?
  isVisible   Boolean    @default(true)
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
  createdAt   DateTime   @default(now())

  @@index([storeId])
}

model Review {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  authorName  String
  authorEmail String?
  rating      Int
  title       String
  comment     String
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([productId, createdAt])
  @@index([storeId])
}

model Order {
  id                    String          @id @default(cuid())
  storeId               String
  store                 Store           @relation(fields: [storeId], references: [id])
  orderNumber           String          @unique
  receiptNumber         String?         @unique
  userId                String?
  user                  User?           @relation(fields: [userId], references: [id])
  email                 String
  fullName              String
  phone                 String?
  address               String
  city                  String
  postalCode            String
  country               String
  totalAmount           Float
  subtotal              Float
  shipping              Float
  tax                   Float
  status                String          @default("pending") // pending, processing, shipped, delivered, cancelled
  paymentMethod         String          @default("card") // cash, card, split, bank_transfer, instapay, wallet
  cashAmount            Float?
  cardAmount            Float?
  notes                 String?
  discountId            String?
  discount              Discount?       @relation(fields: [discountId], references: [id])
  discountAmount        Float?
  shippingMethodId      String?
  shippingMethod        ShippingMethod? @relation(fields: [shippingMethodId], references: [id])
  shipment              Shipment?
  paymentStatus         String          @default("pending")
  fulfilledAt           DateTime?
  reconciledAt          DateTime?
  editHistory           String?
  refundedAmount        Float           @default(0)
  stripePaymentIntentId String?         @unique
  paypalOrderId         String?         @unique
  idempotencyKey        String?         @unique
  walletProvider        String?
  paymentProofUrl       String?
  paymentReference      String?
  paymentVerifiedAt     DateTime?
  processedById         String?
  processedBy           Admin?          @relation(fields: [processedById], references: [id])
  shiftId               String?
  shift                 Shift?          @relation(fields: [shiftId], references: [id])
  items                 OrderItem[]
  returns               Return[]
  returnRequests        ReturnRequest[]
  invoices              Invoice[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([email])
  @@index([status])
  @@index([userId])
  @@index([createdAt])
  @@index([storeId])
}

model OrderItem {
  id         String  @id @default(cuid())
  storeId    String
  store      Store   @relation(fields: [storeId], references: [id])
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  quantity   Int
  price      Float
  discount   Float?
  actualCost Float?

  @@index([storeId])
}

model Return {
  id              String       @id @default(cuid())
  storeId         String
  store           Store        @relation(fields: [storeId], references: [id])
  orderId         String
  order           Order        @relation(fields: [orderId], references: [id])
  shiftId         String?
  shift           Shift?       @relation(fields: [shiftId], references: [id])
  returnNumber    String       @unique
  reason          String // customer_change, defective, wrong_item, damaged, other
  refundMethod    String // cash, card, store_credit, bank_transfer, instapay, wallet, no_refund
  refundAmount    Float
  notes           String?
  restocked       Boolean      @default(true)
  processedById   String?
  processedBy     Admin?       @relation(fields: [processedById], references: [id])
  processedByName String?
  createdAt       DateTime     @default(now())
  items           ReturnItem[]

  @@index([storeId])
}

model ReturnItem {
  id           String  @id @default(cuid())
  storeId      String
  store        Store   @relation(fields: [storeId], references: [id])
  returnId     String
  return       Return  @relation(fields: [returnId], references: [id], onDelete: Cascade)
  productId    String
  product      Product @relation(fields: [productId], references: [id])
  quantity     Int
  refundAmount Float

  @@index([storeId])
}

model Governorate {
  id            String         @id @default(cuid())
  storeId       String
  store         Store          @relation(fields: [storeId], references: [id])
  name          String         @unique
  nameAr        String
  shippingRates ShippingRate[]
  shippingRules ShippingRule[]
  discounts     Discount[]

  @@index([storeId])
}

model ShippingMethod {
  id            String         @id @default(cuid())
  storeId       String
  store         Store          @relation(fields: [storeId], references: [id])
  name          String
  estimatedDays String
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  rates         ShippingRate[]
  shipments     Shipment[]
  rules         ShippingRule[]
  orders        Order[]

  @@index([storeId])
}

model ShippingRate {
  id            String         @id @default(cuid())
  storeId       String
  store         Store          @relation(fields: [storeId], references: [id])
  methodId      String
  method        ShippingMethod @relation(fields: [methodId], references: [id], onDelete: Cascade)
  governorateId String
  governorate   Governorate    @relation(fields: [governorateId], references: [id])
  price         Float

  @@unique([methodId, governorateId])
  @@index([storeId])
}

model ShippingRule {
  id            String          @id @default(cuid())
  storeId       String
  store         Store           @relation(fields: [storeId], references: [id])
  name          String
  methodId      String?
  method        ShippingMethod? @relation(fields: [methodId], references: [id], onDelete: SetNull)
  minAmount     Float?
  governorateId String?
  governorate   Governorate?    @relation(fields: [governorateId], references: [id])
  discountType  String // 'free' | 'percentage' | 'fixed'
  discountValue Float?
  isActive      Boolean         @default(true)
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime        @default(now())

  @@index([storeId])
}

model Shipment {
  id                  String         @id @default(cuid())
  storeId             String
  store               Store          @relation(fields: [storeId], references: [id])
  orderId             String         @unique
  order               Order          @relation(fields: [orderId], references: [id])
  methodId            String
  method              ShippingMethod @relation(fields: [methodId], references: [id])
  trackingNumber      String
  status              String         @default("shipped")
  shippedAt           DateTime?
  estimatedDeliveryAt DateTime?
  deliveredAt         DateTime?
  addressSnapshot     String
  notes               String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([storeId])
}

model Newsletter {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())

  @@index([storeId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  sessionId String
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([sessionId, productId])
  @@index([storeId])
}

model BackInStock {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  email     String
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([email, productId])
  @@index([storeId])
}

enum Gender {
  MALE
  FEMALE
}

model User {
  id            String                @id @default(cuid())
  storeId       String
  store         Store                 @relation(fields: [storeId], references: [id])
  email         String                @unique
  password      String
  name          String
  phone         String?
  avatar        String?
  dateOfBirth   DateTime?
  googleId      String?               @unique
  gender        Gender?
  totpSecret    String?
  totpEnabled   Boolean               @default(false)
  loyaltyPoints Int                   @default(0)
  loyaltyTierId String?
  loyaltyTier   LoyaltyTier?          @relation(fields: [loyaltyTierId], references: [id])
  createdAt     DateTime              @default(now())
  addresses     Address[]
  savedCards    SavedCard[]
  orders        Order[]
  notes         CustomerNote[]
  activityLogs  CustomerActivityLog[]
  emailLogs     EmailLog[]

  @@index([storeId])
}

model CustomerSegment {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  name      String
  rules     Json
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
}

model LoyaltyTier {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  name      String
  minPoints Int
  benefits  Json
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]

  @@index([storeId])
}

model CustomerNote {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminId   String
  note      String
  createdAt DateTime @default(now())

  @@index([storeId])
}

model EmailLog {
  id      String   @id @default(cuid())
  storeId String
  store   Store    @relation(fields: [storeId], references: [id])
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type    String
  subject String
  status  String   @default("sent")
  sentAt  DateTime @default(now())

  @@index([storeId])
}

model CustomerActivityLog {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  details   String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([storeId])
}

model Address {
  id         String   @id @default(cuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName   String
  phone      String?
  street     String
  city       String
  state      String?
  postalCode String
  country    String   @default("EG")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([storeId])
}

model SavedCard {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nickname    String?
  lastFour    String
  expiryMonth Int
  expiryYear  Int
  createdAt   DateTime @default(now())

  @@index([storeId])
}

model BranchStock {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, productId])
  @@index([storeId])
}

model StockTransfer {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
  fromType    String // warehouse, branch
  fromId      String? // branchId if fromType=branch
  toType      String // warehouse, branch
  toId        String? // branchId if toType=branch
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  note        String?
  createdById String
  createdBy   Admin    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([createdById, createdAt])
  @@index([storeId])
}

model Role {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
  name        String   @unique
  permissions String   @default("[]")
  createdAt   DateTime @default(now())
  admins      Admin[]

  @@index([storeId])
}

model Admin {
  id                     String            @id @default(cuid())
  storeId                String
  store                  Store             @relation(fields: [storeId], references: [id])
  email                  String            @unique
  name                   String
  password               String
  role                   String            @default("admin")
  roleId                 String?
  roleRel                Role?             @relation(fields: [roleId], references: [id])
  totpSecret             String?
  totpEnabled            Boolean           @default(false)
  phone                  String?
  lastLoginAt            DateTime?
  failedLoginAttempts    Int               @default(0)
  lockedUntil            DateTime?
  tokenVersion           Int               @default(0)
  createdAt              DateTime          @default(now())
  processedOrders        Order[]
  processedReturns       Return[]
  stockTransfers         StockTransfer[]
  assignedConversations  Conversation[]
  sentMessages           Message[]
  pushTokens             PushToken[]
  pushPreference         PushPreference?
  bankTransactionMatches BankTransaction[]
  payrollRuns            PayrollRun[]
  approvedEntries        JournalEntry[]

  @@index([storeId])
}

model PushToken {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  token     String
  platform  String   @default("android")
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([adminId, token])
  @@index([adminId])
  @@index([storeId])
}

model PushPreference {
  id                String   @id @default(cuid())
  storeId           String
  store             Store    @relation(fields: [storeId], references: [id])
  adminId           String   @unique
  admin             Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  newConversation   Boolean  @default(true)
  newMessage        Boolean  @default(true)
  assignmentChanged Boolean  @default(true)
  sound             Boolean  @default(true)
  quietHoursEnabled Boolean  @default(false)
  quietHoursFrom    String   @default("22:00")
  quietHoursTo      String   @default("08:00")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([storeId])
}

model InventoryLog {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  type      String
  change    Int
  note      String?
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@index([storeId])
}

model Discount {
  id            String       @id @default(cuid())
  storeId       String
  store         Store        @relation(fields: [storeId], references: [id])
  code          String       @unique
  type          String
  value         Float
  appliesTo     String       @default("all") // all, category, tag
  targetValue   String? // category name or tag keyword
  minOrder      Float?
  maxUses       Int?
  usedCount     Int          @default(0)
  isActive      Boolean      @default(true)
  expiresAt     DateTime?
  governorateId String?
  governorate   Governorate? @relation(fields: [governorateId], references: [id])
  createdAt     DateTime     @default(now())
  orders        Order[]
  socialPosts   SocialPost[]

  @@index([storeId])
}

model SiteSetting {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id])
  key     String @unique
  value   String

  @@index([storeId])
}

model Supplier {
  id             String          @id @default(cuid())
  storeId        String
  store          Store           @relation(fields: [storeId], references: [id])
  name           String
  phone          String?
  email          String?
  address        String?
  notes          String?
  createdAt      DateTime        @default(now())
  expenses       Expense[]
  purchaseOrders PurchaseOrder[]
  bills          Bill[]

  @@index([storeId])
}

model Expense {
  id            String    @id @default(cuid())
  storeId       String
  store         Store     @relation(fields: [storeId], references: [id])
  shiftId       String?
  shift         Shift?    @relation(fields: [shiftId], references: [id])
  branchId      String?
  branch        Branch?   @relation(fields: [branchId], references: [id])
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id])
  amount        Float
  paymentMethod String
  description   String
  invoiceNumber String?
  notes         String?
