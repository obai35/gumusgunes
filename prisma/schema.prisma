// Gümüş Güneş — Silver Sun Jewelry E-Commerce Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id             String      @id @default(cuid())
  name           String
  slug           String      @unique
  description    String
  price          Float
  compareAtPrice Float?
  sku            String      @unique
  categoryId     String
  category       Category    @relation(fields: [categoryId], references: [id])
  imageUrl       String
  images         String      // JSON array of image URLs
  material       String
  weight         String?
  rating         Float       @default(0)
  reviewCount    Int         @default(0)
  stock          Int         @default(0)
  tags           String      // JSON array of tags
  isActive       Boolean     @default(true)
  isFeatured     Boolean     @default(false)
  isNew          Boolean     @default(false)
  isBestseller   Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  reviews        Review[]
  orderItems     OrderItem[]
  wishlistItems  WishlistItem[]
  backInStock    BackInStock[]
  inventoryLogs  InventoryLog[]
}

model Category {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String?
  imageUrl    String?
  icon        String?
  parentId    String?
  parent      Category?    @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[]   @relation("CategoryHierarchy")
  products    Product[]
  createdAt   DateTime     @default(now())
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  authorName String
  authorEmail String?
  rating     Int
  title      String
  comment    String
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  receiptNumber String?     @unique
  userId        String?
  user          User?       @relation(fields: [userId], references: [id])
  email         String
  fullName      String
  phone         String?
  address       String
  city          String
  postalCode    String
  country       String
  totalAmount   Float
  subtotal      Float
  shipping      Float
  tax           Float
  status        String      @default("pending") // pending, processing, shipped, delivered, cancelled
  paymentMethod String      @default("card") // cash, card, split, bank_transfer, instapay, wallet
  cashAmount    Float?
  cardAmount    Float?
  notes          String?
  discountId     String?
  discount       Discount?  @relation(fields: [discountId], references: [id])
  discountAmount Float?
  paymentStatus        String     @default("pending")
  stripePaymentIntentId String?   @unique
  paypalOrderId         String?   @unique
  idempotencyKey        String?   @unique
  walletProvider        String?
  paymentProofUrl       String?
  paymentReference      String?
  paymentVerifiedAt     DateTime?
  processedById         String?
  processedBy    Admin?     @relation(fields: [processedById], references: [id])
  shiftId        String?
  shift          Shift?     @relation(fields: [shiftId], references: [id])
  items          OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

model Newsletter {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
}

model WishlistItem {
  id        String   @id @default(cuid())
  sessionId String
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([sessionId, productId])
}

model BackInStock {
  id        String   @id @default(cuid())
  email     String
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([email, productId])
}

model User {
  id          String      @id @default(cuid())
  email       String      @unique
  password    String
  name        String
  phone       String?
  googleId    String?     @unique
  totpSecret  String?
  totpEnabled Boolean     @default(false)
  createdAt   DateTime    @default(now())
  addresses   Address[]
  savedCards  SavedCard[]
  orders      Order[]
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName   String
  phone      String?
  street     String
  city       String
  state      String?
  postalCode String
  country    String   @default("EG")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model SavedCard {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nickname   String?
  lastFour   String
  expiryMonth Int
  expiryYear  Int
  createdAt  DateTime @default(now())
}

model Admin {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  password       String
  role           String   @default("admin")
  totpSecret     String?
  totpEnabled    Boolean  @default(false)
  createdAt      DateTime @default(now())
  processedOrders Order[]
}

model InventoryLog {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  type      String
  change    Int
  note      String?
  createdAt DateTime @default(now())
}

model Discount {
  id          String   @id @default(cuid())
  code        String   @unique
  type        String
  value       Float
  appliesTo   String   @default("all")  // all, category, tag
  targetValue String?                    // category name or tag keyword
  minOrder    Float?
  maxUses     Int?
  usedCount   Int      @default(0)
  isActive    Boolean  @default(true)
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  orders      Order[]
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model Supplier {
  id        String    @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  createdAt DateTime  @default(now())
  expenses  Expense[]
}

model Expense {
  id            String    @id @default(cuid())
  shiftId       String
  shift         Shift     @relation(fields: [shiftId], references: [id])
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id])
  amount        Float
  paymentMethod String
  description   String
  invoiceNumber String?
  notes         String?
  createdAt     DateTime  @default(now())
}

model Shift {
  id                String   @id @default(cuid())
  branchId          String
  branch            Branch   @relation(fields: [branchId], references: [id])
  startedAt         DateTime @default(now())
  closedAt          DateTime?
  startingCash      Float    @default(0)
  endingCash        Float?
  totalCash         Float    @default(0)
  totalCard         Float    @default(0)
  totalBankTransfer Float    @default(0)
  totalInstapay     Float    @default(0)
  totalWallet       Float    @default(0)
  totalSales        Float    @default(0)
  totalExpenses     Float    @default(0)
  orderCount        Int      @default(0)
  notes             String?
  isOpen            Boolean  @default(true)
  orders            Order[]
  expenses          Expense[]
}

model Branch {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  phone     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  shifts    Shift[]
}
