  id         String       @id @default(cuid())
  storeId    String
  store      Store        @relation(fields: [storeId], references: [id])
  productId  String
  product    Product      @relation(fields: [productId], references: [id])
  templateId String?
  template   QC_Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  passed     Boolean
  notes      String?
  checkedBy  String
  createdAt  DateTime     @default(now())

  @@index([storeId])
}

model ScheduledReport {
  id             String    @id @default(cuid())
  storeId        String
  store          Store     @relation(fields: [storeId], references: [id])
  name           String
  type           String // pl, balance_sheet, cash_flow, tax, aging, custom
  config         String    @default("{}")
  schedule       String // daily, weekly, monthly, custom_cron
  cronExpression String?
  recipients     String    @default("[]")
  format         String    @default("pdf")
  lastSentAt     DateTime?
  nextRunAt      DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([nextRunAt])
  @@index([isActive])
  @@index([storeId])
}

model Employee {
  id                String        @id @default(cuid())
  storeId           String
  store             Store         @relation(fields: [storeId], references: [id])
  name              String
  email             String?
  phone             String?
  position          String?
  salary            Float         @default(0)
  bankAccountName   String?
  bankAccountNumber String?
  bankName          String?
  taxId             String?
  notes             String?
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  payrollItems      PayrollItem[]

  @@index([storeId])
}

model PayrollRun {
  id              String        @id @default(cuid())
  storeId         String
  store           Store         @relation(fields: [storeId], references: [id])
  periodStart     DateTime
  periodEnd       DateTime
  totalSalaries   Float         @default(0)
  totalDeductions Float         @default(0)
  totalNet        Float         @default(0)
  status          String        @default("draft") // draft, approved, paid
  processedById   String?
  processedBy     Admin?        @relation(fields: [processedById], references: [id])
  paidAt          DateTime?
  notes           String?
  items           PayrollItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([storeId])
}

model PayrollItem {
  id         String     @id @default(cuid())
  storeId    String
  store      Store      @relation(fields: [storeId], references: [id])
  runId      String
  run        PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  salary     Float      @default(0)
  deductions Float      @default(0)
  bonus      Float      @default(0)
  netPay     Float      @default(0)
  notes      String?

  @@index([runId])
  @@index([storeId])
}
